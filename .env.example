# Server Scanner Dashboard — Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# MongoDB (required for both web dashboard and CronJob sync)
# =============================================================================
MONGO_URI=mongodb://admin:password@localhost:27017
MONGO_DB_NAME=server_scanner

# =============================================================================
# TLS/SSL Verification
# Applies to: HP OneView, Dell OME, Cisco UCS, Kubernetes API, MongoDB
# Set to false when using self-signed / internal certificates (typical in lab)
# =============================================================================
TLS_VERIFY=false

# =============================================================================
# HP OneView (CronJob only)
# =============================================================================
ONEVIEW_IP=10.0.0.1
ONEVIEW_USERNAME=administrator
ONEVIEW_PASSWORD=your-password-here

# =============================================================================
# Dell OpenManage Enterprise (CronJob only)
# =============================================================================
OME_IP=10.0.0.2
OME_USERNAME=admin
OME_PASSWORD=your-password-here

# =============================================================================
# Cisco UCS Central (CronJob only)
# =============================================================================
UCS_CENTRAL_IP=10.0.0.3
UCS_CENTRAL_USERNAME=admin
UCS_CENTRAL_PASSWORD=your-password-here

# Cisco UCS Manager credentials (used to connect to each UCS domain)
UCS_MANAGER_USERNAME=admin
UCS_MANAGER_PASSWORD=your-password-here

# =============================================================================
# Kubernetes (optional — shows live install status on dashboard)
# =============================================================================
K8S_CLUSTER_NAMES=cluster1,cluster2,cluster3
K8S_DOMAIN_NAME=example.com
K8S_NAMESPACE=assisted-installer
# Per-cluster tokens (comma-separated, same order as K8S_CLUSTER_NAMES)
K8S_TOKEN=token-for-cluster1,token-for-cluster2,token-for-cluster3

# =============================================================================
# CronJob Sync Rate-Limiting (Dell OME only)
# =============================================================================
SYNC_BATCH_SIZE=50
SYNC_BATCH_DELAY=1.0

# =============================================================================
# Web Dashboard Settings (optional)
# =============================================================================
CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Zone Filtering (optional — leave empty to show all zones)
# =============================================================================
# ZONES=zone-a,zone-b,zone-c
